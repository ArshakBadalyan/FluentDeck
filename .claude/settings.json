{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NODE_VERSION": "20"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(nvm *)",
      "Bash(npm *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(riovox-api/.env)",
      "Read(**/.env)",
      "Read(**/credentials.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
