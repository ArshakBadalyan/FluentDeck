{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NODE_VERSION": "20"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(nvm *)",
      "Bash(npm *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(strapi-fluentdeck/.env)",
      "Read(**/.env)",
      "Read(**/credentials.json)"
    ]
  }
}
