# Copy to assets/fluentdeck_config.txt before run/build:
#   cp .env.example assets/fluentdeck_config.txt
# Or from a filled .env:
#   cp .env assets/fluentdeck_config.txt

API_URL=http://localhost:1337/api
APP_LANGUAGE=en

# Optional — Strapi REST format: omit or `v4` (default) for legacy nested responses;
# set `v5` for native Strapi 5 flattened REST (parsers support both).
STRAPI_RESPONSE_FORMAT=v4

# Optional — session replay (mobile)
CLARITY_PROJECT_ID=

# Optional — main bottom navigation order (comma-separated tab ids).
# Valid ids: activity, decks, speak, profile (all four required).
MAIN_TAB_ORDER=activity,decks,speak,profile

# Optional — FluentDeck's own shared-decks web page. Leave empty to show a
# "coming soon" state on the Shared Decks screen instead of a dead link.
SHARED_DECKS_WEB_URL=

# Optional — interstitial ads (mobile only)
ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-3940256099942544/1033173712
ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-3940256099942544/4411468910
ADMOB_TEST_DEVICE_IDS=
ADMOB_ENABLED=
ADMOB_ENABLED_IOS=
ADMOB_ENABLED_ANDROID=
