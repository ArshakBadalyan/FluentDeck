# Staging — copy keys, then add values (never commit .env.staging)
#
#   cp .env.staging.example .env.staging
#   nano .env.staging
#
# Docker on server (from deploy/):
#   docker compose --env-file ../.env.staging -f docker-compose.staging.yml up -d --build
#
# Do not use production secrets on staging.
#
# CI failure email: set STAGING_NOTIFY_EMAILS, SMTP_USERNAME, SMTP_PASSWORD
# in GitHub → Settings → Secrets (Actions) only — not in this file.

# --- Docker / Postgres (compose) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
HTTP_PORT=

HOST=
PORT=

# --- Strapi secrets (generate new values for staging) ---
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=

PUBLIC_URL=
DATABASE_URL=

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# DB (optional; Docker uses DATABASE_URL from compose)
ENVIRONMENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_SELF=

OPENAI_API_KEY=

GROQ_API_KEY=

# Tutor voice: our own servers (see .env.example); unset = text only
KOKORO_BASE_URL=
PIPER_BASE_URL=
MELOTTS_BASE_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Daily AI practice time, in minutes (free vs premium)
FREE_DAILY_MINUTES=5
PREMIUM_DAILY_MINUTES=240
DISABLE_DAILY_CONVERSATION_LIMIT=

I18N_DEFAULT_LOCALE=
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

CRON_ENABLED=
