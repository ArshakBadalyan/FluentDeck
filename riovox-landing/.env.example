# Copy to .env and fill in. All values are public (they end up in the HTML).
# Production URL of this site (canonical links, Open Graph, sitemap, robots.txt).
SITE_URL=https://riovox.app
# Riovox web app. Default /app/ = same domain and server as this page
# (see README "One domain"). Buttons add ?auth=signup or ?auth=signin.
WEB_APP_URL=/app/
# Store listings. Empty = the badge shows "Coming soon".
APP_STORE_URL=
PLAY_STORE_URL=
# Legal pages and contact.
PRIVACY_URL=
TERMS_URL=
CONTACT_EMAIL=hello@riovox.app
