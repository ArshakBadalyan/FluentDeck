{
  "kind": "collectionType",
  "collectionName": "placement_test_results",
  "info": {
    "singularName": "placement-test-result",
    "pluralName": "placement-test-results",
    "displayName": "Placement Test Result",
    "description": "Vocabulary placement test history and suggested CEFR level."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "suggestedLevel": {
      "type": "enumeration",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"],
      "required": true
    },
    "levelBucket": {
      "type": "enumeration",
      "enum": ["beginner", "intermediate", "advanced"],
      "required": true
    },
    "score": {
      "type": "decimal",
      "required": true
    },
    "answersSummary": {
      "type": "json",
      "default": {}
    },
    "takenAt": {
      "type": "datetime",
      "required": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
