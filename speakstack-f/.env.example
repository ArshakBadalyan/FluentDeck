# Copy to assets/english_config.txt before run/build:
#   cp .env.example assets/english_config.txt
# Or copy your local .env:
#   cp .env assets/english_config.txt
#
# Legacy assets/mathe_config.txt still works as a fallback.
#
# Web release:
#   flutter build web --release --base-href /web/ --pwa-strategy none

# Strapi API (required)
API_URL=http://localhost:1337/api

# App locale: en | de
APP_LANGUAGE=en

# Push notifications (OneSignal)
ONESIGNAL_APP_ID=

# Microsoft Clarity (optional)
CLARITY_PROJECT_ID=

# AdMob (optional — test IDs below are Google's sample units)
ADMOB_INTERSTITIAL_ID_ANDROID=
ADMOB_INTERSTITIAL_ID_IOS=
ADMOB_TEST_DEVICE_IDS=
ADMOB_ENABLED=
ADMOB_ENABLED_IOS=
ADMOB_ENABLED_ANDROID=

# Monetization: users with Strapi `special=true` get unlimited AI conversations.
# Free users: 10 conversations per day (tracked locally in the app).
