# Staging — copy keys, then add values (never commit .env.staging)
#
#   cp .env.staging.example .env.staging
#   nano .env.staging
#
# Docker on server (from deploy/):
#   docker compose --env-file ../.env.staging -f docker-compose.staging.yml up -d --build
#
# Do not use production secrets on staging.
#
# CI failure email: set STAGING_NOTIFY_EMAILS, SMTP_USERNAME, SMTP_PASSWORD
# in GitHub → Settings → Secrets (Actions) only — not in this file.

# --- Docker / Postgres (compose) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
HTTP_PORT=

HOST=
PORT=

# --- Strapi secrets (generate new values for staging) ---
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=

MY_HEROKU_URL=
DATABASE_URL=

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_CONGRATS_TEMPLATE_ID=
ONESIGNAL_UNFINISHED_GOAL_TEMPLATE_ID=

# DB (optional; Docker uses DATABASE_URL from compose)
ENVIRONMENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_SELF=

OPENAI_API_KEY=
OPENAI_API_KEY_DAVO=

SMTP_USERNAME=
SMTP_PASSWORD=

# Daily tutor-turn caps (free non-subscribers vs premium)
FREE_DAILY_CONVERSATION_TURNS=10
PREMIUM_DAILY_CONVERSATION_TURNS=60
DISABLE_DAILY_CONVERSATION_LIMIT=

I18N_DEFAULT_LOCALE=
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

CRON_ENABLED=
PARENT_DAILY_REPORT_UNSUBSCRIBE_URL=
