{
  "name": "fluentdeck-api",
  "private": true,
  "version": "2.0.9",
  "description": "Riovox English learning API (Strapi)",
  "scripts": {
    "develop": "node scripts/ensure-migrations-baseline.js && strapi develop",
    "start": "node scripts/ensure-migrations-baseline.js && strapi start",
    "build": "strapi build",
    "heroku-postbuild": "strapi build",
    "strapi": "strapi",
    "test:apkg": "node tests/apkg-import.test.js",
    "test:queue": "node --test tests/flashcard-review-queue.test.js",
    "test:speaking-premium": "node --test tests/speaking-premium-access.test.js",
    "test:ai-rate-limit": "node --test tests/ai-rate-limit.test.js tests/daily-conversation-limits.test.js tests/subscription-plans.test.js",
    "test:flashcard-import": "node --test tests/flashcard-import.test.js",
    "test:browse-filter": "node --test tests/flashcard-browse-filter.test.js",
    "test:apkg-import": "node --test tests/flashcard-apkg-import.test.js",
    "test:daily-reminder": "node --test tests/daily-reminder.test.js",
    "test:app-locales": "node --test tests/translate-app-locales.test.js tests/speaking-languages.test.js",
    "test:ads-stt": "node --test tests/ads-and-stt.test.js tests/tts-provider.test.js",
    "translate:app-locales": "node scripts/translate-app-locales.js",
    "test": "yarn test:apkg && yarn test:queue && yarn test:speaking-premium && yarn test:ai-rate-limit && yarn test:language-levels && yarn test:flashcard-import && yarn test:browse-filter && yarn test:apkg-import && yarn test:daily-reminder && yarn test:app-locales && yarn test:ads-stt",
    "test:language-levels": "node --test tests/language-level-analytics.test.js tests/speaking-proficiency-assessment.test.js"
  },
