{
  "kind": "collectionType",
  "collectionName": "subscriptions",
  "info": {
    "singularName": "subscription",
    "pluralName": "subscriptions",
    "displayName": "Subscription",
    "description": "Per-user premium subscription state, verified against Apple/Google."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "platform": {
      "type": "enumeration",
      "enum": ["ios", "android"],
      "required": true
    },
    "productId": {
      "type": "string",
      "required": true
    },
    "originalTransactionId": {
      "type": "string"
    },
    "purchaseToken": {
      "type": "text"
    },
    "subscriptionStatus": {
      "type": "enumeration",
      "enum": ["active", "expired", "cancelled", "grace_period", "billing_retry"],
      "default": "active",
      "required": true
    },
    "currentPeriodEnd": {
      "type": "datetime",
      "required": true
    },
    "autoRenewing": {
      "type": "boolean",
      "default": true
    },
    "lastVerifiedAt": {
      "type": "datetime"
    },
    "lastEventPayload": {
      "type": "json"
    }
  }
}
