{
  "kind": "collectionType",
  "collectionName": "vocabulary_entries",
  "info": {
    "singularName": "vocabulary-entry",
    "pluralName": "vocabulary-entries",
    "displayName": "Vocabulary Entry",
    "description": "Atomic vocabulary sense catalog (CEFR-tagged, frequency-ordered)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "word": {
      "type": "string",
      "required": true
    },
    "lemma": {
      "type": "string"
    },
    "entryType": {
      "type": "enumeration",
      "enum": ["word", "phrase", "idiom", "expression"],
      "default": "word",
      "required": true
    },
    "partOfSpeech": {
      "type": "string"
    },
    "definition": {
      "type": "text",
      "required": true
    },
    "exampleSentence": {
      "type": "text"
    },
    "examples": {
      "type": "json"
    },
    "ipa": {
      "type": "string"
    },
    "audioUrl": {
      "type": "string"
    },
    "cefrLevel": {
      "type": "enumeration",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
    },
    "topic": {
      "type": "string"
    },
    "frequencyRank": {
      "type": "integer",
      "default": 0
    },
    "frequencyBucket": {
      "type": "string"
    },
    "sensePriority": {
      "type": "enumeration",
      "enum": ["core", "extend", "rare"]
    },
    "source": {
      "type": "string",
      "default": "import"
    },
    "externalId": {
      "type": "string",
      "unique": true
    },
    "userProgress": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-vocabulary-progress.user-vocabulary-progress",
      "mappedBy": "vocabularyEntry"
    }
  }
}
