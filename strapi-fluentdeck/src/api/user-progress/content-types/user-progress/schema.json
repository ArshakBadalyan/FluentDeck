{
  "kind": "collectionType",
  "collectionName": "user_progresses",
  "info": {
    "singularName": "user-progress",
    "pluralName": "user-progresses",
    "displayName": "User Progress",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "currentLevel": {
      "type": "enumeration",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"],
      "default": "B1"
    },
    "weakAreas": {
      "type": "json",
      "default": []
    },
    "streakDays": {
      "type": "integer",
      "default": 0
    },
    "totalSpeakingMinutes": {
      "type": "integer",
      "default": 0
    },
    "perfectSentencesCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "uniqueWordsUsed": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "spokenWordBank": {
      "type": "json",
      "default": []
    },
    "lastPracticeAt": {
      "type": "datetime"
    },
    "completedExercises": {
      "type": "json",
      "default": []
    },
    "flashcardReviewStreakDays": {
      "type": "integer",
      "default": 0
    },
    "lastFlashcardReviewAt": {
      "type": "datetime"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "user_progress"
    }
  }
}
