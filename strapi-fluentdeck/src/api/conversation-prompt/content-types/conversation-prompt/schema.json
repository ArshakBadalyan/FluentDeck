{
  "kind": "collectionType",
  "collectionName": "conversation_prompts",
  "info": {
    "singularName": "conversation-prompt",
    "pluralName": "conversation-prompts",
    "displayName": "Conversation Prompt",
    "description": "Role-play scenarios for speaking practice"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "scenario": {
      "type": "text",
      "required": true
    },
    "difficultyLevel": {
      "type": "enumeration",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"],
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "daily_life",
        "career",
        "travel",
        "relationships",
        "language_testing",
        "custom"
      ],
      "default": "daily_life"
    },
    "userRole": {
      "type": "string"
    },
    "tutorRole": {
      "type": "string"
    },
    "iconKey": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "suggestedVocabulary": {
      "type": "json"
    },
    "accessMode": {
      "type": "enumeration",
      "enum": ["automatic", "free", "premium"],
      "default": "automatic"
    }
  }
}
