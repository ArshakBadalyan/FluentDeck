{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": false
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "unique": true,
      "configurable": false,
      "required": false
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "required": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "name": {
      "type": "string"
    },
    "surname": {
      "type": "string"
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "users_permissions_user"
    },
    "user_timezone": {
      "type": "string",
      "private": true
    },
    "app_opened_datetime": {
      "type": "datetime",
      "private": true
    },
    "push_subscribed": {
      "type": "boolean",
      "default": false
    },
    "special": {
      "type": "boolean",
      "default": false
    },
    "sound": {
      "type": "boolean",
      "default": true
    },
    "volume_sound": {
      "type": "integer",
      "default": 50,
      "required": true,
      "max": 100,
      "min": 0
    },
    "music": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "volume_music": {
      "type": "integer",
      "required": true,
      "default": 50,
      "max": 100,
      "min": 0
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "hide_screen_explanation": {
      "type": "boolean",
      "default": false
    },
    "english_level": {
      "type": "enumeration",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"],
      "default": "A1"
    },
    "practice_language": {
      "type": "enumeration",
      "enum": ["en", "es", "fr", "de", "it", "pt", "zh", "ja", "ru", "hi"],
      "default": "en"
    },
    "sync_learning_language": {
      "type": "boolean",
      "default": true
    },
    "auto_save_corrections": {
      "type": "boolean",
      "default": true
    },
    "auto_create_flashcards": {
      "type": "boolean",
      "default": true
    },
    "response_language": {
      "type": "enumeration",
      "enum": ["en", "es", "fr", "de", "it", "hi", "pt", "zh", "ja", "ru"],
      "default": "en"
    },
    "translation_language": {
      "type": "enumeration",
      "enum": ["none", "en", "es", "fr", "de", "it", "hi", "pt", "zh", "ja", "ru", "ar", "hy", "ko", "tr", "uk"],
      "default": "none"
    },
    "show_translations": {
      "type": "boolean",
      "default": false
    },
    "auto_play_voice": {
      "type": "boolean",
      "default": true
    },
    "auto_conversation": {
      "type": "boolean",
      "default": false
    },
    "speaking_auto_notes_count": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "private": true
    },
    "tutor_memory": {
      "type": "json",
      "default": [],
      "private": true
    },
    "ai_turns_date": {
      "type": "string",
      "private": true
    },
    "ai_turns_count": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "private": true
    },
    "ai_session_opens_date": {
      "type": "string",
      "private": true
    },
    "ai_session_opens_count": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "private": true
    },
    "correct_sentences_today_date": {
      "type": "string"
    },
    "correct_sentences_today_count": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "type_messages_enabled": {
      "type": "boolean",
      "default": false
    },
    "auto_start_recording": {
      "type": "boolean",
      "default": false
    },
    "auto_start_recording_delay_seconds": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 10
    },
    "daily_reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "daily_reminder_time": {
      "type": "string",
      "default": "09:00"
    },
    "daily_reminder_last_sent_date": {
      "type": "string",
      "private": true
    },
    "tutor_voice": {
      "type": "enumeration",
      "enum": ["alloy", "echo", "fable", "onyx", "nova", "shimmer"],
      "default": "nova"
    },
    "correct_sentence_goal": {
      "type": "integer",
      "default": 10,
      "min": 1,
      "max": 100
    },
    "user_progress": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::user-progress.user-progress",
      "mappedBy": "user"
    },
    "old_data": {
      "type": "json",
      "private": true
    }
  }
}
