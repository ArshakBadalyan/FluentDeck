# Staging: cp .env.staging.example .env.staging — see STAGING-DEPLOYMENT.md

HOST=
PORT=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=

DATABASE_URL=
# Public address of the API in production, e.g. https://api.riovox.app
PUBLIC_URL=
TRANSFER_TOKEN_SALT=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

#DB CREDENTIALS
ENVIRONMENT=#local / production
# Comma-separated allowed browser origins for API CORS (use * only in local dev)
CORS_ORIGIN=*

# Auth brute-force protection (requests per IP per window; disable with DISABLE_AUTH_RATE_LIMIT=true)
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_FORGOT=5
AUTH_RATE_LIMIT_SSO=20
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_SELF=

#OPENAI
OPENAI_API_KEY=

# AI English tutor (optional overrides; defaults: gpt-4o-mini, whisper-1, tts-1, nova)
AI_TUTOR_MODEL=
AI_WHISPER_MODEL=
AI_TTS_VOICE=
AI_CEFR_LEVEL_MODEL=
AI_WORD_MEANING_MODEL=

#MAILING (any SMTP provider: Resend, Brevo, Amazon SES, …)
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender of every email, e.g. Riovox <no-reply@riovox.app>
EMAIL_FROM=
EMAIL_REPLY_TO=

# Daily AI practice time, in minutes (metered by real conversation time —
# see src/utils/ai-rate-limit.js). Free users: default 5.
FREE_DAILY_MINUTES=5
# Subscribers, when a plan sets no SUBSCRIPTION_<PLAN>_DAILY_MINUTES: default 240 (4 h)
PREMIUM_DAILY_MINUTES=240
# Hard ceiling for every plan's daily minutes (default 360 = 6 h)
MAX_DAILY_MINUTES=360
# Pauses longer than this (seconds) are "away" and not charged. Default 90.
AI_USAGE_IDLE_GAP_SECONDS=90
# Dev: skip the daily cap (also auto-off when ENVIRONMENT=local or strapi develop)
DISABLE_DAILY_CONVERSATION_LIMIT=

# Premium plans — duration, display price, daily minutes (store prices still from Apple/Google)
SUBSCRIPTION_MONTHLY_PRODUCT_ID=fluentdeck_premium_monthly
SUBSCRIPTION_MONTHLY_TITLE=Monthly
SUBSCRIPTION_MONTHLY_DURATION_MONTHS=1
SUBSCRIPTION_MONTHLY_PRICE=9.99
SUBSCRIPTION_MONTHLY_CURRENCY=USD
SUBSCRIPTION_MONTHLY_DAILY_MINUTES=240
SUBSCRIPTION_MONTHLY_TRIAL_DAYS=0

SUBSCRIPTION_YEARLY_PRODUCT_ID=fluentdeck_premium_yearly
SUBSCRIPTION_YEARLY_TITLE=Yearly
SUBSCRIPTION_YEARLY_DURATION_MONTHS=12
SUBSCRIPTION_YEARLY_PRICE=79.99
SUBSCRIPTION_YEARLY_CURRENCY=USD
SUBSCRIPTION_YEARLY_BADGE=Save 33%
SUBSCRIPTION_YEARLY_DAILY_MINUTES=240
# Label only — the trial itself is set up in App Store Connect / Play Console.
SUBSCRIPTION_YEARLY_TRIAL_DAYS=7

# No longer sold, still honoured for existing subscribers (comma-separated)
SUBSCRIPTION_LEGACY_PRODUCT_IDS=fluentdeck_premium_quarterly

#LOCALIZATION
I18N_DEFAULT_LOCALE=
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=

# Sign in with Apple — iOS bundle id (comma-separate Services ID for Android/web)
APPLE_CLIENT_ID=

# Subscriptions — Apple receipt/notification verification
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=
# "production" or unset/anything else for sandbox
APPLE_ENVIRONMENT=
# Required only when APPLE_ENVIRONMENT=production (App Store Connect -> App Information -> Apple ID)
APPLE_APP_APPLE_ID=

# Subscriptions — Google Play receipt/notification verification
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
# Shared secret appended as ?token= on the Pub/Sub push endpoint URL you configure in GCP
GOOGLE_PUBSUB_WEBHOOK_TOKEN=

# Flashcard review defaults (Again/Hard/Good minutes, Easy days) — overridden by Strapi App Feature Config
FLASHCARD_DEFAULT_LEARNING_STEPS=2,8,10
FLASHCARD_DEFAULT_EASY_INTERVAL_DAYS=5

#AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Ads by region (src/utils/ad-regions.js). Outside the high-value countries,
# free users see an interstitial when starting a conversation and never get
# ad-earned minutes. ISO alpha-2, comma-separated; empty = built-in list.
AD_HIGH_VALUE_COUNTRIES=
CONVERSATION_START_AD=true
CONVERSATION_START_AD_COOLDOWN_MINUTES=5
REWARDED_MINUTES_ENABLED=false

# Speech-to-text: Groq Whisper (~9x cheaper) when set; falls back to OpenAI on errors.
GROQ_API_KEY=
# AI_STT_PROVIDER=openai          # force OpenAI whisper-1
# AI_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Tutor voice: our own servers only, no paid text-to-speech. Each is any
# OpenAI-compatible /audio/speech server, on when its *_BASE_URL is set.
#   Kokoro  (en, es, fr, it, pt, ja, zh, hi): self-hosted Kokoro-FastAPI
#   Piper   (de, ru, ar, tr, vi): an OpenAI-compatible Piper server
#   MeloTTS (ko)
# Indonesian and Armenian have no voice (text only). A language whose server
# isn't set, or a server that fails, gives text only.
KOKORO_BASE_URL=
KOKORO_API_KEY=
KOKORO_MODEL=kokoro
PIPER_BASE_URL=
PIPER_API_KEY=
PIPER_MODEL=piper
# PIPER_VOICES={"de":{"f":"de_DE-kerstin-low","m":"de_DE-thorsten-medium"}}
MELOTTS_BASE_URL=
MELOTTS_API_KEY=
MELOTTS_MODEL=melotts
