# Staging: cp .env.staging.example .env.staging — see STAGING-DEPLOYMENT.md

HOST=
PORT=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=

DATABASE_URL=
MY_HEROKU_URL=
TRANSFER_TOKEN_SALT=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_CONGRATS_TEMPLATE_ID=
ONESIGNAL_UNFINISHED_GOAL_TEMPLATE_ID=
# Optional: OneSignal template for new class assignments (uses direct push if empty)
ONESIGNAL_NEW_ASSIGNMENT_TEMPLATE_ID=

#DB CREDENTIALS
ENVIRONMENT=#local / production
# Comma-separated allowed browser origins for API CORS (use * only in local dev)
CORS_ORIGIN=*

# Auth brute-force protection (requests per IP per window; disable with DISABLE_AUTH_RATE_LIMIT=true)
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_FORGOT=5
AUTH_RATE_LIMIT_SSO=20
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_SELF=

#OPENAI
OPENAI_API_KEY=
OPENAI_API_KEY_DAVO=

# AI English tutor (optional overrides; defaults: gpt-4o-mini, whisper-1, tts-1, nova)
AI_TUTOR_MODEL=
AI_WHISPER_MODEL=
AI_TTS_MODEL=
AI_TTS_VOICE=

#MAILING
SMTP_USERNAME=
SMTP_PASSWORD=

# Daily conversation (tutor turn) caps — counted in user.ai_turns_count per day
# Non-subscribers (free): default 10
FREE_DAILY_CONVERSATION_TURNS=10
# Subscribers (premium): default 60
PREMIUM_DAILY_CONVERSATION_TURNS=60
# Dev: skip daily conversation turn cap (also auto-off when ENVIRONMENT=local or strapi develop)
DISABLE_DAILY_CONVERSATION_LIMIT=

# User-adjustable daily conversations slider (prices scale from plan base @ DAILY_TURNS)
SUBSCRIPTION_DAILY_TURNS_MIN=20
SUBSCRIPTION_DAILY_TURNS_MAX=120
SUBSCRIPTION_DAILY_TURNS_DEFAULT=60

# Premium plans — duration + base price at DAILY_TURNS (store prices still from Apple/Google)
SUBSCRIPTION_MONTHLY_PRODUCT_ID=fluentdeck_premium_monthly
SUBSCRIPTION_MONTHLY_TITLE=Monthly
SUBSCRIPTION_MONTHLY_DURATION_MONTHS=1
SUBSCRIPTION_MONTHLY_PRICE=9.99
SUBSCRIPTION_MONTHLY_CURRENCY=EUR
SUBSCRIPTION_MONTHLY_DAILY_TURNS=60

SUBSCRIPTION_QUARTERLY_PRODUCT_ID=fluentdeck_premium_quarterly
SUBSCRIPTION_QUARTERLY_TITLE=Quarterly
SUBSCRIPTION_QUARTERLY_DURATION_MONTHS=3
SUBSCRIPTION_QUARTERLY_PRICE=25.99
SUBSCRIPTION_QUARTERLY_CURRENCY=EUR
SUBSCRIPTION_QUARTERLY_BADGE=Save 13%
SUBSCRIPTION_QUARTERLY_DAILY_TURNS=60

SUBSCRIPTION_YEARLY_PRODUCT_ID=fluentdeck_premium_yearly
SUBSCRIPTION_YEARLY_TITLE=Yearly
SUBSCRIPTION_YEARLY_DURATION_MONTHS=12
SUBSCRIPTION_YEARLY_PRICE=69.99
SUBSCRIPTION_YEARLY_CURRENCY=EUR
SUBSCRIPTION_YEARLY_BADGE=Best value
SUBSCRIPTION_YEARLY_DAILY_TURNS=60

#LOCALIZATION
I18N_DEFAULT_LOCALE=
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=

# Sign in with Apple — iOS bundle id (comma-separate Services ID for Android/web)
APPLE_CLIENT_ID=

# Subscriptions — Apple receipt/notification verification
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=
# "production" or unset/anything else for sandbox
APPLE_ENVIRONMENT=
# Required only when APPLE_ENVIRONMENT=production (App Store Connect -> App Information -> Apple ID)
APPLE_APP_APPLE_ID=

# Subscriptions — Google Play receipt/notification verification
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
# Shared secret appended as ?token= on the Pub/Sub push endpoint URL you configure in GCP
GOOGLE_PUBSUB_WEBHOOK_TOKEN=

# Flashcard review defaults (Again/Hard/Good minutes, Easy days) — overridden by Strapi App Feature Config
FLASHCARD_DEFAULT_LEARNING_STEPS=2,8,10
FLASHCARD_DEFAULT_EASY_INTERVAL_DAYS=5

#AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

#Parents daily digest unsubscribe link base (cron email); default schulmatheapp.de/unsubscribe.php
PARENT_DAILY_REPORT_UNSUBSCRIBE_URL=
