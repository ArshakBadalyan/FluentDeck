# Staging: cp .env.staging.example .env.staging — see STAGING-DEPLOYMENT.md

HOST=
PORT=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=

DATABASE_URL=
MY_HEROKU_URL=
TRANSFER_TOKEN_SALT=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_CONGRATS_TEMPLATE_ID=
ONESIGNAL_UNFINISHED_GOAL_TEMPLATE_ID=
# Optional: OneSignal template for new class assignments (uses direct push if empty)
ONESIGNAL_NEW_ASSIGNMENT_TEMPLATE_ID=

#DB CREDENTIALS
ENVIRONMENT=#local / production
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL_SELF=

#OPENAI
OPENAI_API_KEY=
OPENAI_API_KEY_DAVO=

# AI English tutor (optional overrides; defaults: gpt-4o-mini, whisper-1, tts-1, nova)
AI_TUTOR_MODEL=
AI_WHISPER_MODEL=
AI_TTS_MODEL=
AI_TTS_VOICE=

#MAILING
SMTP_USERNAME=
SMTP_PASSWORD=

# Dev: skip free-tier daily conversation turn cap (also auto-off when ENVIRONMENT=local or strapi develop)
DISABLE_DAILY_CONVERSATION_LIMIT=

#LOCALIZATION
I18N_DEFAULT_LOCALE=
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=

# Sign in with Apple — iOS bundle id (comma-separate Services ID for Android/web)
APPLE_CLIENT_ID=

# Subscriptions — Apple receipt/notification verification
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=
# "production" or unset/anything else for sandbox
APPLE_ENVIRONMENT=
# Required only when APPLE_ENVIRONMENT=production (App Store Connect -> App Information -> Apple ID)
APPLE_APP_APPLE_ID=

# Subscriptions — Google Play receipt/notification verification
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
# Shared secret appended as ?token= on the Pub/Sub push endpoint URL you configure in GCP
GOOGLE_PUBSUB_WEBHOOK_TOKEN=

# Flashcard review defaults (Again/Hard/Good minutes, Easy days) — overridden by Strapi App Feature Config
FLASHCARD_DEFAULT_LEARNING_STEPS=2,8,10
FLASHCARD_DEFAULT_EASY_INTERVAL_DAYS=5

#AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

#Parents daily digest unsubscribe link base (cron email); default schulmatheapp.de/unsubscribe.php
PARENT_DAILY_REPORT_UNSUBSCRIBE_URL=
