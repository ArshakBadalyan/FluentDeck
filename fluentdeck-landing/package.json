    "serve": "node server.mjs",
    "media": "python3 scripts/build-media.py"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "5.4.11"
  },
  "dependencies": {
    "motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
