{
  "name": "fluentdeck-landing",
  "private": true,
  "version": "1.0.0",
  "description": "FluentDeck marketing site: AI English speaking practice.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:app": "cd ../fluentdeck-f && flutter build web --release --base-href /app/",
